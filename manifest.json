{
  "manifest_version": 3,
  "name": "MentiChecker",
  "version": "1.2.8",
  "author": "D4SHW00D",
  "description": "Slide inspector for Mentimeter - floating panel on every menti.com page.",
  "permissions":
  [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions":
  [
    "https://generativelanguage.googleapis.com/*",
    "*://*.menti.com/*",
    "*://menti.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action":
  {
    "default_popup": "popup.html",
    "default_icon":
    {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons":
  {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts":
  [
    {
      "matches":
      [
        "*://*.menti.com/*",
        "*://menti.com/*"
      ],
      "js": [ "pageWorld.js" ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches":
      [
        "*://*.menti.com/*",
        "*://menti.com/*"
      ],
      "js": [ "content.js" ],
      "run_at": "document_idle"
    }
  ]
}